{
    "application": "topological_offset",
    "input": "../models/two_circles.msh",
    "offset_selection": "circle_a | circle_b",
    "offset_output_tags": ["offset"],
    "target_distance": 0.1,
    "offset_field": "smooth",
    "convergence_gradient_norm_rel": 0.01,
    "stop_energy": 10,
    "pre_optimize_input": true,
    "pre_optimize_sizing_from_edges": true,
    "sizing_propagate_min": true,
    "preallocation_factor": 60.0,
    "perform_sanity_checks": true,
    "num_threads": 0
}
