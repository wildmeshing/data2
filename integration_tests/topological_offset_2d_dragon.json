{
    "application": "topological_offset",
    "input": "../models/dragon_rectangle.msh",
    "offset_selection": "tag_3",
    "offset_output_tags": ["offset"],
    "target_distance_rel": 0.01,
    "offset_out": true,
    "convergence_target_rel": 0.001,
